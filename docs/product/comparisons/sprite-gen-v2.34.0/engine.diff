+    total = width * height
+    alpha_zero = alpha.histogram()[0]
+    edges = [(0, 0, width, 1), (0, height - 1, width, height),
+             (0, 1, 1, height - 1), (width - 1, 1, width, height - 1)]
+    edges = [box for box in edges if box[2] > box[0] and box[3] > box[1]]
