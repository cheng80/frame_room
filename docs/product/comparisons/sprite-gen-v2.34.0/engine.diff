+    elif alpha_zero_pct >= RAW_ALPHA_MIN_ZERO_PCT and border_alpha_zero_pct >= RAW_ALPHA_MIN_BORDER_ZERO_PCT:
+        verdict = RAW_ALPHA_REAL
+    else:
+        verdict = RAW_ALPHA_AMBIGUOUS
